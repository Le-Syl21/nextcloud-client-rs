#
# System service template, one instance per user, running as that user
# (never as root): ncsyncd@alice runs as alice.
#   /var/lib/ncsyncd/<user>/ncsyncd.cfg   the configuration (nextcloud.cfg format)
#   /var/lib/ncsyncd/<user>/              state, owned by <user> (journals live in the folders)
#   /run/ncsyncd/<user>/control.sock      the control socket
# Credentials, one per account, either
#   - a systemd credential ncsyncd-<user>-<account id> in the credential store
#     (/etc/credstore.encrypted, /etc/credstore, ...), imported below:
#       systemd-creds encrypt --name=ncsyncd-alice-0 app-password.txt \
#           /etc/credstore.encrypted/ncsyncd-alice-0
#   - or the password file `ncsync account add --instance <user>` writes to
#     /var/lib/ncsyncd/<user>/credentials/ncsyncd-<account id> (mode 0600).
# Set up as root with `ncsync ... --instance <user>`, then
#   systemctl enable --now ncsyncd@<user>
# ImportCredential= needs systemd 254 or later.
[Unit]
Description=Nextcloud sync daemon for %i (ncsyncd, unofficial)
Documentation=https://github.com/Le-Syl21/nextcloud-client-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=%i
ExecStart=/usr/bin/ncsyncd --instance %i
ExecReload=/bin/kill -HUP $MAINPID
ImportCredential=ncsyncd-%i-*
StateDirectory=ncsyncd/%i
StateDirectoryMode=0700
RuntimeDirectory=ncsyncd/%i
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10s
WatchdogSec=120s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
