#
# System service template, one instance per configuration:
#   /etc/ncsyncd/<instance>.cfg       the configuration (nextcloud.cfg format)
#   credentials, one per account, either
#     - a systemd credential named ncsyncd-<account id> (drop-in below), or
#     - the password file `ncsync account add --instance <instance>` writes
#       to /var/lib/ncsyncd/<instance>/credentials/ncsyncd-<account id>
#   /var/lib/ncsyncd/<instance>/      state (journals live in the folders)
#   /run/ncsyncd/<instance>/control.sock  the control socket
#   systemctl enable --now ncsyncd@<instance>
# The daemon runs as root unless a drop-in sets User= (the synchronized
# folders must then belong to that user, and so must the state directory):
#   systemctl edit ncsyncd@<instance>   ->   [Service] User=alice Group=alice
# systemd credentials (plain file, or encrypted with
# `systemd-creds encrypt --name=ncsyncd-0 secret.txt /etc/credstore.encrypted/ncsyncd-0`):
#   systemctl edit ncsyncd@<instance>   ->   [Service]
#                                            LoadCredential=ncsyncd-0:/etc/ncsyncd/<instance>/ncsyncd-0
#                                            (or LoadCredentialEncrypted=ncsyncd-0:/etc/credstore.encrypted/ncsyncd-0)
[Unit]
Description=Nextcloud sync daemon for %i (ncsyncd, unofficial)
Documentation=https://github.com/Le-Syl21/nextcloud-client-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/ncsyncd --instance %i
ExecReload=/bin/kill -HUP $MAINPID
StateDirectory=ncsyncd/%i
RuntimeDirectory=ncsyncd/%i
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10s
WatchdogSec=120s
TimeoutStopSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
